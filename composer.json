{
    "name": "pinosite/laravel-pino-pay",
    "description": "Laravel package for the Pino Pay payment gateway: ask for a payment, send the customer to it and verify it.",
    "type": "library",
    "keywords": ["laravel", "payment", "gateway", "iran", "ipg", "pino-pay"],
    "homepage": "https://github.com/OR81/pino-pay-integrations",
    "license": "MIT",
    "authors": [
        {
            "name": "Pino Site",
            "homepage": "https://pinosite.ir"
        }
    ],
    "support": {
        "issues": "https://github.com/OR81/pino-pay-integrations/issues",
        "source": "https://github.com/OR81/pino-pay-integrations",
        "docs": "https://github.com/OR81/pino-pay-integrations/blob/main/docs/laravel.md"
    },
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.2|^8.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "PinoSite\\PinoPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PinoSite\\PinoPay\\Tests\\": "tests/"
        },
        "classmap": [
            "wordpress/pino-pay-for-woocommerce/includes/class-pinopay-order-data.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "PinoSite\\PinoPay\\PinoPayServiceProvider"
            ],
            "aliases": {
                "PinoPay": "PinoSite\\PinoPay\\Facades\\PinoPay"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
